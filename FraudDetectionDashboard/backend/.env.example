# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MONGO_URI or MONGODB_URI)
MONGO_URI=mongodb://localhost:27017/fraud_detection
MONGODB_URI=mongodb://localhost:27017/fraud_detection

# Allowed CORS Origins & Frontend URL
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional: Path to compiled C++ Fraud Engine binary (leave blank for auto-detection)
CPP_ENGINE_PATH=
