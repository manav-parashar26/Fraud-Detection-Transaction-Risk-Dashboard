# ==============================================================================
# Fraud Detection & Transaction Risk Dashboard — Environment Variables Template
# Copy this file to .env and configure as appropriate for your environment
# ==============================================================================

# Backend API Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection String (supports MONGO_URI and MONGODB_URI)
MONGO_URI=mongodb://localhost:27017/fraud_detection
MONGODB_URI=mongodb://localhost:27017/fraud_detection

# Allowed CORS Origins (comma-separated for multi-origin deployments)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional: Path to compiled C++ Fraud Engine binary (leave blank for automatic resolution)
CPP_ENGINE_PATH=

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
